# Solo nombres: los valores reales viven en las variables del proyecto en Vercel
# y, para desarrollo local, en .env.local (no versionado). Nunca pongas un valor aquí.

# API de Merez (lectura pública del blog y envío de leads). Opcional: tiene valor por defecto.
NEXT_PUBLIC_MEREZ_API_URL=
# Solo servidor: sobrescribe la API para leer contenido. Opcional.
MEREZ_CONTENT_API_URL=
# Slug del sitio en Merez. Por defecto "inflinds".
MEREZ_SITE_SLUG=

# SDK de Merez (analítica, formularios y chat). Sin la llave de ingest el SDK no se carga.
NEXT_PUBLIC_MEREZ_SDK_URL=
NEXT_PUBLIC_MEREZ_INGEST_KEY=
NEXT_PUBLIC_MEREZ_PORTAL_PARTNER=

# Pixel de Meta. Opcional.
NEXT_PUBLIC_META_PIXEL_ID=
